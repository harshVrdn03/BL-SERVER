NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bookleaf
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,https://bl-client-beryl.vercel.app
LOG_LEVEL=info
AI_ENABLED=false
AI_MODEL=nvidia/nemotron-3-super-120b-a12b
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
AI_MAX_INPUT_CHARS=2000
AI_TIMEOUT_MS=20000
